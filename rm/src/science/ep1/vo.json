"lines": [
{
"who": "ZIB",
"text": "Oops. I deleted the Moon.",
"s": 0.0,
"e": 1.562
},
{
"who": "PIP",
"text": "You what? Zib, the Moon does real work up there!",
"s": 1.812,
"e": 4.946
},
{
"who": "BOLT",
"text": "Correction. It did.",
"s": 5.146,
"e": 6.248
},
{
"who": "PIP",
"text": "First, tides. The Moon's gravity pulls the oceans into two big bulges.",
"s": 6.548,
"e": 11.166
},
{
"who": "BOLT",
"text": "The Sun pulls too, so tides survive. Just less than half as big.",
"s": 11.366,
"e": 15.393
},
{
"who": "ZIB",
"text": "Tiny waves! Cute!",
"s": 15.593,
"e": 16.948
},
{
"who": "PIP",
"text": "Not cute. Coastal life runs on those tides. And nights get way darker.",
"s": 17.148,
"e": 21.804
},
{
"who": "BOLT",
"text": "A full Moon is nearly two thousand times brighter than Venus.",
"s": 22.004,
"e": 25.431
},
{
"who": "PIP",
"text": "Then the slow part. The Moon keeps Earth's tilt steady. That tilt gives us seasons.",
"s": 25.731,
"e": 30.854
},
{
"who": "BOLT",
"text": "Today it only swings about two and a half degrees. Without the Moon, the other planets could tip it much further.",
"s": 31.054,
"e": 37.543
},
{
"who": "PIP",
"text": "Over millions of years, seasons could go wild. Blazing summers. Brutal winters.",
"s": 37.743,
"e": 42.87
},
{
"who": "ZIB",
"text": "So... I should press undo?",
"s": 43.12,
"e": 44.66
},
{
"who": "BOLT",
"text": "Recommended.",
"s": 44.86,
"e": 45.627
},
{
"who": "PIP",
"text": "Tides or dark nights, which would you miss first? Tell us in the comments.",
"s": 45.927,
"e": 50.194
},
{
"who": "ZIB",
"text": "Oops. Wrong button.",
"s": 50.344,
"e": 51.575
}
],
"dur": 52.975
}