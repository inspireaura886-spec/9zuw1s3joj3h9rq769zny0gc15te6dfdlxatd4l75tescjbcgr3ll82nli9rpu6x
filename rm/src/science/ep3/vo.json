"lines": [
{
"who": "ZIB",
"text": "I brought you a teaspoon of neutron star!",
"s": 0.0,
"e": 2.272
},
{
"who": "PIP",
"text": "Zib. Do not. Drop it.",
"s": 2.472,
"e": 4.246
},
{
"who": "BOLT",
"text": "That spoonful weighs about a billion tons. As much as a mountain.",
"s": 4.496,
"e": 8.349
},
{
"who": "PIP",
"text": "A neutron star is what's left when a giant star collapses. More mass than our Sun, crushed into a ball about twenty kilometres wide.",
"s": 8.599,
"e": 17.226
},
{
"who": "ZIB",
"text": "So it's heavy. I'm strong!",
"s": 17.426,
"e": 18.991
},
{
"who": "BOLT",
"text": "Weight is not the problem.",
"s": 19.191,
"e": 20.548
},
{
"who": "PIP",
"text": "Out there, crushing gravity holds that matter together. Bring it to Earth, and nothing holds it.",
"s": 20.798,
"e": 26.196
},
{
"who": "BOLT",
"text": "Like opening a shaken soda. Except the soda is a star.",
"s": 26.396,
"e": 29.833
},
{
"who": "PIP",
"text": "Astronomers say it would expand in a giant explosion that could vaporize a good chunk of our planet.",
"s": 30.083,
"e": 36.321
},
{
"who": "ZIB",
"text": "So... can I keep it in space?",
"s": 36.571,
"e": 38.289
},
{
"who": "BOLT",
"text": "Approved.",
"s": 38.489,
"e": 39.166
},
{
"who": "PIP",
"text": "Would you dare to touch the spoon? Yes or no in the comments.",
"s": 39.466,
"e": 43.0
},
{
"who": "ZIB",
"text": "I brought another one!",
"s": 43.15,
"e": 44.523
}
],
"dur": 45.923
