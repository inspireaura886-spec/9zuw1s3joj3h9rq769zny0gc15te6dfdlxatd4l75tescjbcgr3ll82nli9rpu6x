"lines": [
{
"who": "PIP",
"text": "I dug a hole straight through the Earth.",
"s": 0.0,
"e": 1.974
},
{
"who": "ZIB",
"text": "Dibs! Wheee!",
"s": 2.124,
"e": 3.132
},
{
"who": "BOLT",
"text": "Assume no air, no heat, and a very unreasonable shovel.",
"s": 3.382,
"e": 6.606
},
{
"who": "PIP",
"text": "At first, Zib falls like he jumped off a diving board. Faster every single second.",
"s": 6.856,
"e": 12.273
},
{
"who": "BOLT",
"text": "Even in the simple model, he passes the center at nearly eight kilometres per second.",
"s": 12.473,
"e": 17.422
},
{
"who": "ZIB",
"text": "I'm a comet!",
"s": 17.622,
"e": 18.682
},
{
"who": "PIP",
"text": "But once he passes the center, gravity pulls him backwards. He slows down, all the way up the other side.",
"s": 18.882,
"e": 25.336
},
{
"who": "BOLT",
"text": "Trip time: thirty-eight minutes. A McGill physicist calculated it with real seismic data.",
"s": 25.536,
"e": 31.473
},
{
"who": "PIP",
"text": "Textbooks said forty-two. Earth's heavy core makes the fall faster.",
"s": 31.673,
"e": 35.705
},
{
"who": "ZIB",
"text": "Hello, other side! Wait. Why am I going down again?",
"s": 35.955,
"e": 38.753
},
{
"who": "BOLT",
"text": "Nothing catches him, so he falls back. And forth. Forever.",
"s": 38.953,
"e": 42.258
},
{
"who": "PIP",
"text": "Would you jump in? Yes or no in the comments.",
"s": 42.458,
"e": 45.271
},
{
"who": "ZIB",
"text": "Wheee!",
"s": 45.421,
"e": 46.17
}
],
